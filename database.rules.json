{
  "rules": {
    "rooms": {
      "$code": {
        ".write": "(!data.exists() && newData.child('meta/hostId').val() === auth.uid) || (!newData.exists() && data.child('meta/hostId').val() === auth.uid)",
        "meta": {
          ".read": "auth != null",
          ".write": "data.child('hostId').val() === auth.uid"
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "$uid === auth.uid && (!newData.exists() || root.child('rooms/' + $code + '/meta/status').val() === 'lobby')",
            "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "score": {
              ".write": "root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid",
              ".validate": "newData.isNumber()"
            }
          }
        },
        "round": {
          ".read": "auth != null",
          ".write": "root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid"
        },
        "reveal": {
          ".read": "auth != null",
          ".write": "root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid"
        },
        "answered": {
          ".read": "auth != null",
          ".write": "root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid",
          "$uid": {
            ".write": "$uid === auth.uid && !data.exists() && root.child('rooms/' + $code + '/meta/status').val() === 'playing'",
            ".validate": "newData.val() === true"
          }
        },
        "answers": {
          ".read": "auth != null && (root.child('rooms/' + $code + '/meta/status').val() === 'reveal' || root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid)",
          ".write": "root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid",
          "$uid": {
            ".write": "$uid === auth.uid && !data.exists() && root.child('rooms/' + $code + '/meta/status').val() === 'playing' && now <= root.child('rooms/' + $code + '/round/endsAt').val()",
            ".validate": "newData.hasChildren(['text', 'submittedAt'])",
            "text": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "submittedAt": { ".validate": "newData.val() === now" }
          }
        }
      }
    }
  }
}
